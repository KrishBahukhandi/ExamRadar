# ExamRadar India - Environment Configuration Template
# Copy to .env for local development. Never commit real keys.

# ==========================================
# Deployment Mode
# MODE_A: Supabase direct + local/scheduled runner (Zero-cost MVP)
# MODE_B: Full Spring Boot API + Postgres (Conventional backend)
# ==========================================
EXAMRADAR_DEPLOYMENT_MODE=MODE_A

# ==========================================
# Supabase Configuration
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...public-anon-key-placeholder
# Service role key is only used by trusted background collector/admin jobs - NEVER client-side
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# ==========================================
# Database (PostgreSQL / Supabase direct connection)
# ==========================================
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project
DB_PASSWORD=your-secure-db-password-placeholder
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=require
SPRING_DATASOURCE_USERNAME=${DB_USER}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# ==========================================
# Firebase Cloud Messaging (FCM)
# ==========================================
FIREBASE_CONFIG_PATH=/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=examradar-india-placeholder

# ==========================================
# Security & Admin Access
# ==========================================
ADMIN_API_KEY=admin-secret-key-placeholder-min-32-chars
SECURITY_ENCRYPTION_SALT=random-salt-placeholder

# ==========================================
# Collector Runtime Settings
# ==========================================
COLLECTOR_USER_AGENT=ExamRadarBot/1.0 (+https://examradar.in/bot; bot@examradar.in)
COLLECTOR_TIMEOUT_MS=15000
COLLECTOR_MAX_RETRIES=3
COLLECTOR_RATE_LIMIT_DELAY_MS=2000
