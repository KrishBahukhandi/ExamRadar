# OS Files
.DS_Store
Thumbs.db

# IDE & Editor files
.idea/
*.iml
.vscode/
*.swp
*.swo

# Build outputs
**/build/
bin/
**/target/
out/
**/.gradle/

# Android
*.apk
*.aab
local.properties
.cxx/
captures/

# Secrets and environment files — NEVER commit real credentials
.env
.env.*
*.local.env

# Android signing keystores — keep outside the repo
*.keystore
*.jks
*.key
*.pem

# Firebase credentials — inject via env var at runtime
**/google-services.json
**/*firebase*.json
**/*-firebase-adminsdk-*.json
**/firebase-service-account.json
**/service-account.json
**/gcloud-credentials.json

# Supabase / cloud credentials
supabase-keys.json
private-key.pem

# Logs
*.log
logs/

# Test reports
test-output/
jacoco/

